{
	"name": "pi-cursor-workers",
	"version": "0.3.0",
	"description": "Pi package: delegate exploration, implementation, tests, and review to persistent named Cursor agents over ACP",
	"type": "module",
	"keywords": ["pi-package"],
	"engines": {
		"node": ">=22.19"
	},
	"files": ["extensions", "lib", "skills", "prompts", "docs", "scripts/configure-cursor.mjs", "scripts/cache-insights.mjs", "README.md"],
	"scripts": {
		"test": "node --test test/*.test.mjs test/cache-insights/*.test.mjs",
		"check": "node scripts/check.mjs",
		"configure:cursor": "node scripts/configure-cursor.mjs",
		"smoke:extension": "node scripts/extension-smoke.mjs",
		"cache-insights": "node scripts/cache-insights.mjs",
		"smoke:live": "node scripts/live-smoke.mjs"
	},
	"pi": {
		"extensions": ["./extensions/cursor.ts", "./extensions/progress-update.ts", "./extensions/approval-history.ts", "./extensions/cache-insights/index.ts"],
		"skills": ["./skills"],
		"prompts": ["./prompts/*.md"]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	}
}
